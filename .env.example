# ---- core ----
ENVIRONMENT=development            # development | test | production
DATABASE_URL=                      # blank => SQLite at data/dev.sqlite3. Compose: postgresql+psycopg://sih:sih@postgres:5432/sih
REDIS_URL=                         # e.g. redis://redis:6379/0 (needed only when JOB_BACKEND=celery)
JOB_BACKEND=inline                 # inline (FastAPI background tasks) | celery
JWT_SECRET=                        # REQUIRED in production, >= 32 random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000

# ---- AI providers (all optional; defaults run fully offline) ----
LLM_PROVIDER=extractive            # extractive | anthropic | openai
EMBEDDING_PROVIDER=hashing         # hashing | openai   (changing it requires re-ingesting documents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- search backend (abstraction; only `local` is implemented) ----
SEARCH_BACKEND=local
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ---- object storage (local filesystem implementation; S3 adapter is a drop-in) ----
OBJECT_STORAGE_URL=                # blank => data/documents/_store
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---- limits ----
MAX_UPLOAD_BYTES=15728640
RATE_LIMIT_ENABLED=true

# ---- web ----
API_INTERNAL_URL=http://localhost:8000   # where Next.js proxies /api/v1/*
